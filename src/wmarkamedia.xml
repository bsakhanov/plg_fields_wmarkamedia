<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="fields" method="upgrade">
	<name>plg_fields_wmarkamedia</name>
	<author>Beibit Sakhanov</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Beibit Sakhanov</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorUrl>https://webmarka.kz</authorUrl>
	<version>1.2.0</version>
	<description>PLG_FIELDS_WMARKAMEDIA_XML_DESCRIPTION</description>
	<namespace path="src">Wmarka\Plugin\Fields\WmarkaMedia</namespace>
	<scriptfile>script.php</scriptfile>
	<files>
		<folder>params</folder>
		<folder plugin="wmarkamedia">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<filename>LICENSE.txt</filename>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_fields_wmarkamedia.ini</language>
		<language tag="en-GB">language/en-GB/plg_fields_wmarkamedia.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_fields_wmarkamedia.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_fields_wmarkamedia.sys.ini</language>
		<language tag="kk-KZ">language/kk-KZ/plg_fields_wmarkamedia.ini</language>
		<language tag="kk-KZ">language/kk-KZ/plg_fields_wmarkamedia.sys.ini</language>
	</languages>
	<media destination="plg_fields_wmarkamedia" folder="media">
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<updateservers>
		<server type="extension" priority="1" name="Wmarka Media">https://raw.githubusercontent.com/bsakhanov/plg_fields_wmarkamedia/main/updates.xml</server>
	</updateservers>
	<config>
		<fields name="params">
			<fieldset name="basic" label="PLG_FIELDS_WMARKAMEDIA_FIELDSET_VIDEO">
				<field name="mode" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_MODE" default="facade" validate="options">
					<option value="facade">PLG_FIELDS_WMARKAMEDIA_MODE_FACADE</option>
					<option value="iframe">PLG_FIELDS_WMARKAMEDIA_MODE_IFRAME</option>
				</field>
				<field name="poster" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_POSTER" default="auto" validate="options">
					<option value="auto">PLG_FIELDS_WMARKAMEDIA_POSTER_AUTO</option>
					<option value="article">PLG_FIELDS_WMARKAMEDIA_POSTER_ARTICLE</option>
					<option value="none">PLG_FIELDS_WMARKAMEDIA_POSTER_NONE</option>
				</field>
				<field name="ratio" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_RATIO" default="auto" validate="options">
					<option value="auto">PLG_FIELDS_WMARKAMEDIA_RATIO_AUTO</option>
					<option value="16:9">16:9</option>
					<option value="9:16">9:16</option>
					<option value="4:5">4:5</option>
					<option value="1:1">1:1</option>
					<option value="4:3">4:3</option>
				</field>
				<field name="vertical_max_width" type="number" label="PLG_FIELDS_WMARKAMEDIA_PARAM_VMAX" default="360" min="200" max="720" step="10" filter="integer" />
				<field name="nocookie" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_NOCOOKIE" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="telegram" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_TELEGRAM" description="PLG_FIELDS_WMARKAMEDIA_PARAM_TELEGRAM_DESC" default="link" validate="options">
					<option value="link">PLG_FIELDS_WMARKAMEDIA_TELEGRAM_LINK</option>
					<option value="embed">PLG_FIELDS_WMARKAMEDIA_TELEGRAM_EMBED</option>
				</field>
				<field name="show_link" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_SHOWLINK" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="jsonld" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_JSONLD" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="gallery" label="PLG_FIELDS_WMARKAMEDIA_FIELDSET_GALLERY">
				<field name="columns" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_COLUMNS" default="3" validate="options">
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
				</field>
				<field name="thumbs" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_THUMBS" default="auto" validate="options">
					<option value="auto">PLG_FIELDS_WMARKAMEDIA_THUMBS_AUTO</option>
					<option value="none">PLG_FIELDS_WMARKAMEDIA_THUMBS_NONE</option>
				</field>
				<field name="thumb_width" type="number" label="PLG_FIELDS_WMARKAMEDIA_PARAM_THUMBWIDTH" default="640" min="200" max="2000" step="50" filter="integer" />
				<field name="full_width" type="number" label="PLG_FIELDS_WMARKAMEDIA_PARAM_FULLWIDTH" default="1920" min="800" max="4000" step="100" filter="integer" />
				<field name="preview_count" type="number" label="PLG_FIELDS_WMARKAMEDIA_PARAM_PREVIEW" default="0" min="0" max="500" step="1" filter="integer" />
				<field name="lightbox" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_LIGHTBOX" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_caption" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_SHOWCAPTION" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_credit" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_SHOWCREDIT" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="links" label="PLG_FIELDS_WMARKAMEDIA_FIELDSET_LINKS">
				<field name="style" type="list" label="PLG_FIELDS_WMARKAMEDIA_PARAM_STYLE" default="list" validate="options">
					<option value="list">PLG_FIELDS_WMARKAMEDIA_STYLE_LIST</option>
					<option value="buttons">PLG_FIELDS_WMARKAMEDIA_STYLE_BUTTONS</option>
				</field>
				<field name="new_tab" type="radio" label="PLG_FIELDS_WMARKAMEDIA_PARAM_NEWTAB" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
